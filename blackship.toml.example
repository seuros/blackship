# Blackship Configuration Example
# FreeBSD Jail Orchestrator with TOML-based Configuration

[config]
# Base directory for jail data
data_dir = "/var/blackship"

# Enable ZFS-backed jails
zfs_enabled = true
zpool = "zroot"
dataset = "blackship"

# How often `supervise` samples racct usage into scope peaks and OTLP gauges.
# 0 disables sampling.
usage_sample_secs = 30

# Optional OTLP telemetry export. Omit the table to disable it; lifecycle
# events are written to <data_dir>/audit/<jail>.jsonl either way.
# [telemetry]
# endpoint = "http://127.0.0.1:4318"
# service_name = "blackship"
# timeout_secs = 5
# metrics_interval_secs = 30
# [telemetry.headers]
# authorization = "Bearer <token>"

# Optional global network configuration
[[networks]]
name = "backend"
subnet = "10.0.1.0/24"
gateway = "10.0.1.1"

[[networks]]
name = "frontend"
subnet = "10.0.2.0/24"

# Database jail - no dependencies
[[jails]]
name = "postgres"
path = "/jails/postgres"
hostname = "db.local"

[jails.params]
"allow.raw_sockets" = true
"exec.start" = "/bin/sh /etc/rc"
"exec.stop" = "/bin/sh /etc/rc.shutdown jail"

[jails.network]
networks = ["backend"]
ip = "10.0.1.10"

# Two-phase QoS. `transition` is one of "healthy" (first passing healthcheck,
# needs `supervise`), "timer" (max_startup_secs elapses), or "manual"
# (`blackship qos <jail> --steady`).
[jails.qos]
transition = "healthy"
max_startup_secs = 120

[jails.qos.startup]
memory = "4g"
cpu = "400"

[jails.qos.steady]
memory = "2g"
cpu = "200"
rules = ["jail:blackship-postgres:cputime:devctl=/dev/devctl"]

# Refuse new TCP connections and wait for in-flight ones before teardown.
[jails.drain]
enabled = true
timeout_secs = 30

# Redis cache - depends on nothing
[[jails]]
name = "redis"
path = "/jails/redis"
hostname = "cache.local"

[jails.network]
networks = ["backend"]
ip = "10.0.1.11"

# Backend API - depends on postgres and redis
[[jails]]
name = "api"
path = "/jails/api"
hostname = "api.local"
depends_on = ["postgres", "redis"]

# What happens to dependents when this jail goes down:
#   "strict"  - stop them too (default)
#   "detach"  - stop only this jail
#   "isolate" - leave them running but block new connections to them
cascade = "strict"

# Whether `blackship gc` may destroy this jail's dataset when reclaiming it.
ephemeral = false

[jails.params]
"allow.sysvipc" = true

[jails.network]
networks = ["backend"]
ip = "10.0.1.20"

# Frontend web server - depends on api
[[jails]]
name = "nginx"
path = "/jails/nginx"
hostname = "web.local"
depends_on = ["api"]

[jails.network]
networks = ["frontend"]
ip = "10.0.2.10"

[jails.mount]
volumes = ["/data/static:/usr/local/www/static:ro"]
